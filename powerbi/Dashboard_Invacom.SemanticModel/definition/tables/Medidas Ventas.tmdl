table 'Medidas Ventas'
	lineageTag: 7815bb72-c3be-4d69-a58c-b6291f42cac5

	/// Venta total (precio + flete) sin órdenes canceladas ni no disponibles
	measure 'Ventas válidas' =
			CALCULATE (
				SUM ( FACT_VENTAS[MONTO_TOTAL] ),
				NOT DIM_ESTADO_ORDEN[ESTADO_ORDEN_ES] IN { "Cancelada", "No disponible" }
			)
		formatString: #,0
		displayFolder: KPIs Ventas
		lineageTag: c685eaff-d0bb-49ff-817c-0aad05e5c906

	/// Órdenes únicas sin canceladas ni no disponibles
	measure 'Órdenes válidas' =
			CALCULATE (
				DISTINCTCOUNT ( FACT_VENTAS[ORDER_ID] ),
				NOT DIM_ESTADO_ORDEN[ESTADO_ORDEN_ES] IN { "Cancelada", "No disponible" }
			)
		formatString: #,0
		displayFolder: KPIs Ventas
		lineageTag: 3c79d6eb-b00b-4271-8568-7994d9158356

	/// Cantidad de meses del filtro actual que tienen ventas
	measure 'Meses con ventas' =
			COUNTROWS (
				FILTER ( VALUES ( DIM_TIEMPO[ANIO_MES] ), [Ventas válidas] > 0 )
			)
		formatString: 0
		displayFolder: KPIs Ventas
		lineageTag: a4dc5b5f-5c6a-4acf-bf4c-6a8491b5f854

	/// KPI-VEN-01: ventas válidas divididas entre los meses del período
	measure 'Ventas promedio mensuales' = DIVIDE ( [Ventas válidas], [Meses con ventas] )
		formatString: #,0
		displayFolder: KPIs Ventas
		lineageTag: 1db46947-1e47-4d5e-8b4f-5e7523265729

	/// KPI-VEN-02: órdenes válidas divididas entre los meses del período
	measure 'Órdenes promedio mensuales' = DIVIDE ( [Órdenes válidas], [Meses con ventas] )
		formatString: #,0
		displayFolder: KPIs Ventas
		lineageTag: 86655ac8-8613-43af-a24d-ce93829d671b

	/// KPI-VEN-01 del mes anterior
	measure 'Ventas mes anterior' = CALCULATE ( [Ventas promedio mensuales], DATEADD ( DIM_TIEMPO[FECHA], -1, MONTH ) )
		formatString: #,0
		displayFolder: KPIs Ventas
		lineageTag: 5c0fa562-f0e9-450e-8766-2669ac038d52

	/// Cambio % de KPI-VEN-01 contra el mes anterior
	measure 'Var VEN-01 vs mes anterior' = DIVIDE ( [Ventas promedio mensuales] - [Ventas mes anterior], [Ventas mes anterior] )
		formatString: 0.00%
		displayFolder: KPIs Ventas
		lineageTag: 76f5d8b9-9b84-4488-b538-f218e90df26c

	/// KPI-VEN-02 del mes anterior
	measure 'Órdenes mes anterior' = CALCULATE ( [Órdenes promedio mensuales], DATEADD ( DIM_TIEMPO[FECHA], -1, MONTH ) )
		formatString: #,0
		displayFolder: KPIs Ventas
		lineageTag: cac37875-2ae1-4169-afc7-1d751c6f76d2

	/// Cambio % de KPI-VEN-02 contra el mes anterior
	measure 'Var VEN-02 vs mes anterior' = DIVIDE ( [Órdenes promedio mensuales] - [Órdenes mes anterior], [Órdenes mes anterior] )
		formatString: 0.00%
		displayFolder: KPIs Ventas
		lineageTag: 60b61a89-54df-4058-992e-26dcb68ffa63

	/// Meta de KPI-VEN-01 leída de la tabla Metas KPI
	measure 'Meta VEN-01' = LOOKUPVALUE ( 'Metas KPI'[Meta], 'Metas KPI'[Codigo], "KPI-VEN-01" )
		formatString: #,0
		displayFolder: KPIs Ventas
		lineageTag: a8d5ac95-8bd9-4013-a71b-4dc054d93429

	/// Meta de KPI-VEN-02 leída de la tabla Metas KPI
	measure 'Meta VEN-02' = LOOKUPVALUE ( 'Metas KPI'[Meta], 'Metas KPI'[Codigo], "KPI-VEN-02" )
		formatString: #,0
		displayFolder: KPIs Ventas
		lineageTag: e2df577e-de2b-41d9-b0d3-c29f4b3a7e59

	/// Color del semáforo de KPI-VEN-01 (mayor es mejor). Se usa en formato condicional: fx > Valor del campo
	measure 'Color VEN-01' =
			VAR valor = [Ventas promedio mensuales]
			VAR verde = LOOKUPVALUE ( 'Metas KPI'[LimiteVerde], 'Metas KPI'[Codigo], "KPI-VEN-01" )
			VAR rojo  = LOOKUPVALUE ( 'Metas KPI'[LimiteRojo],  'Metas KPI'[Codigo], "KPI-VEN-01" )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( valor ), BLANK (),
			        valor >= verde, "#2E7D32",
			        valor <  rojo,  "#C62828",
			        "#F9A825"
			    )
		displayFolder: KPIs Ventas
		lineageTag: b2c99ebf-9af1-4432-9505-6730c6e2a128

	/// Color del semáforo de KPI-VEN-02 (mayor es mejor). Se usa en formato condicional: fx > Valor del campo
	measure 'Color VEN-02' =
			VAR valor = [Órdenes promedio mensuales]
			VAR verde = LOOKUPVALUE ( 'Metas KPI'[LimiteVerde], 'Metas KPI'[Codigo], "KPI-VEN-02" )
			VAR rojo  = LOOKUPVALUE ( 'Metas KPI'[LimiteRojo],  'Metas KPI'[Codigo], "KPI-VEN-02" )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( valor ), BLANK (),
			        valor >= verde, "#2E7D32",
			        valor <  rojo,  "#C62828",
			        "#F9A825"
			    )
		displayFolder: KPIs Ventas
		lineageTag: af5988ea-22b2-4eb5-b5e6-86633a473536

	column Columna1
		dataType: string
		isHidden
		lineageTag: 9a817a6d-efa1-43e8-9461-dc54cd2c54fe
		summarizeBy: none
		sourceColumn: Columna1

		annotation SummarizationSetBy = Automatic

	partition 'Medidas Ventas' = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}})
				in
				    #"Tipo cambiado"

	annotation PBI_ResultType = Table

